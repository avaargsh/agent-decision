{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:avaargsh:agent-decision:decision-record:v1",
  "title": "DecisionRecord",
  "description": "Immutable, tenant-attributed decision ledger record. The record is a proposal or abstention; it is never an execution permit.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision_id",
    "tenant_id",
    "subject_id",
    "agent_id",
    "session_id",
    "run_id",
    "idempotency_key",
    "request_sha256",
    "strategy_version",
    "prompt_version",
    "model_profile",
    "capability_catalog_version",
    "status",
    "reason_codes",
    "replan_sequence",
    "max_replans",
    "context_snapshot",
    "capability_snapshot",
    "evidence_refs",
    "plan",
    "created_at"
  ],
  "properties": {
    "decision_id": {
      "type": "string",
      "pattern": "^dec_[a-f0-9]{64}$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$"
    },
    "subject_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$"
    },
    "agent_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$"
    },
    "session_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$",
      "description": "Runtime-issued Run ID created after accepting a Control Plane RunIntent; Decision records this reference and never creates it."
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$"
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "strategy_version": {
      "type": "string",
      "minLength": 1
    },
    "prompt_version": {
      "type": "string",
      "minLength": 1
    },
    "model_profile": {
      "type": "string",
      "minLength": 1
    },
    "capability_catalog_version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "PROPOSED",
        "ABSTAINED"
      ]
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "parent_decision_id": {
      "type": "string",
      "pattern": "^dec_[a-f0-9]{64}$"
    },
    "replan_sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "max_replans": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "context_snapshot": {
      "$ref": "#/$defs/SnapshotRef"
    },
    "capability_snapshot": {
      "$ref": "#/$defs/SnapshotRef"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      }
    },
    "plan": {
      "$ref": "#/$defs/PlanCandidate"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "SnapshotRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "sha256",
        "source",
        "attestation_ref",
        "trust_level",
        "issued_at",
        "expires_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "attestation_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "trust_level": {
          "const": "attested",
          "type": "string"
        },
        "issued_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "EvidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "evidence_type",
        "schema_version",
        "tenant_id",
        "agent_id",
        "run_id",
        "service",
        "resource_ref",
        "source_id",
        "source",
        "source_version",
        "sha256",
        "attestation_ref",
        "trust_level",
        "observed_from",
        "observed_to",
        "observed_at",
        "collected_at",
        "expires_at",
        "revocation_state"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "source_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "attestation_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "trust_level": {
          "const": "attested",
          "type": "string"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "evidence_type": {
          "type": "string",
          "enum": [
            "metrics",
            "logs",
            "traces",
            "change",
            "slo"
          ]
        },
        "schema_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "tenant_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$"
        },
        "agent_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$"
        },
        "run_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$"
        },
        "service": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$"
        },
        "resource_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "observed_from": {
          "type": "string",
          "format": "date-time"
        },
        "observed_to": {
          "type": "string",
          "format": "date-time"
        },
        "collected_at": {
          "type": "string",
          "format": "date-time"
        },
        "revocation_state": {
          "type": "string",
          "const": "active"
        }
      }
    },
    "CapabilityRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "contract_sha256",
        "input_schema_ref",
        "output_schema_ref",
        "effect_class",
        "idempotency",
        "tenant_scoped"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "contract_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "input_schema_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "output_schema_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "effect_class": {
          "const": "read_only",
          "type": "string"
        },
        "idempotency": {
          "const": "safe",
          "type": "string"
        },
        "tenant_scoped": {
          "const": true,
          "type": "boolean"
        }
      }
    },
    "PlanStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step_id",
        "kind",
        "capability",
        "target_ref",
        "input_schema_ref",
        "output_schema_ref",
        "read_only"
      ],
      "properties": {
        "step_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "capability": {
          "$ref": "#/$defs/CapabilityRef"
        },
        "target_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "input_schema_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "output_schema_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "read_only": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "PlanCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plan_id",
        "schema_version",
        "steps",
        "plan_hash"
      ],
      "properties": {
        "plan_id": {
          "type": "string",
          "pattern": "^plan_[a-f0-9]{32}$"
        },
        "schema_version": {
          "const": "decision.v1",
          "type": "string"
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PlanStep"
          }
        },
        "plan_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
