{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avaargsh.github.io/agent-decision/schemas/decision-record.v1.json",
  "title": "DecisionRecord v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision_id", "tenant_id", "subject_id", "agent_id", "session_id", "run_id", "idempotency_key", "request_sha256", "strategy_version", "prompt_version", "model_profile", "capability_catalog_version", "status", "reason_codes", "replan_sequence", "max_replans", "context_snapshot", "capability_snapshot", "evidence_refs", "plan", "created_at"],
  "properties": {
    "decision_id": {"type": "string", "pattern": "^dec_[a-f0-9]{64}$"},
    "tenant_id": {"$ref": "#/$defs/name"},
    "subject_id": {"$ref": "#/$defs/name"},
    "agent_id": {"$ref": "#/$defs/name"},
    "session_id": {"$ref": "#/$defs/name"},
    "run_id": {"$ref": "#/$defs/name"},
    "idempotency_key": {"$ref": "#/$defs/name"},
    "request_sha256": {"$ref": "#/$defs/sha256"},
    "strategy_version": {"const": "sre-readonly-v1"},
    "prompt_version": {"const": "none"},
    "model_profile": {"const": "rule-only"},
    "capability_catalog_version": {"$ref": "#/$defs/name"},
    "status": {"enum": ["PROPOSED", "ABSTAINED"]},
    "reason_codes": {"type": "array", "items": {"$ref": "#/$defs/name"}},
    "parent_decision_id": {"type": "string", "pattern": "^dec_[a-f0-9]{64}$"},
    "replan_sequence": {"type": "integer", "minimum": 0, "maximum": 3},
    "max_replans": {"type": "integer", "minimum": 0, "maximum": 3},
    "context_snapshot": {"$ref": "#/$defs/snapshotRef"},
    "capability_snapshot": {"$ref": "#/$defs/snapshotRef"},
    "evidence_refs": {"type": "array", "items": {"$ref": "#/$defs/evidenceRef"}},
    "plan": {"$ref": "#/$defs/planCandidate"},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "name": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "snapshotRef": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "sha256", "source", "attestation_ref", "trust_level", "issued_at", "expires_at"],
      "properties": {
        "id": {"$ref": "#/$defs/name"}, "version": {"$ref": "#/$defs/name"}, "sha256": {"$ref": "#/$defs/sha256"},
        "source": {"$ref": "#/$defs/name"}, "attestation_ref": {"$ref": "#/$defs/name"}, "trust_level": {"const": "attested"},
        "issued_at": {"type": "string", "format": "date-time"}, "expires_at": {"type": "string", "format": "date-time"}
      }
    },
    "evidenceRef": {
      "type": "object", "additionalProperties": false,
      "required": ["ref", "source", "source_version", "sha256", "attestation_ref", "trust_level", "observed_at", "expires_at"],
      "properties": {
        "ref": {"$ref": "#/$defs/name"}, "source": {"$ref": "#/$defs/name"}, "source_version": {"$ref": "#/$defs/name"},
        "sha256": {"$ref": "#/$defs/sha256"}, "attestation_ref": {"$ref": "#/$defs/name"}, "trust_level": {"const": "attested"},
        "observed_at": {"type": "string", "format": "date-time"}, "expires_at": {"type": "string", "format": "date-time"}
      }
    },
    "capabilityRef": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "contract_sha256", "input_schema_ref", "output_schema_ref", "effect_class", "idempotency", "tenant_scoped"],
      "properties": {
        "id": {"$ref": "#/$defs/name"}, "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "contract_sha256": {"$ref": "#/$defs/sha256"}, "input_schema_ref": {"$ref": "#/$defs/name"}, "output_schema_ref": {"$ref": "#/$defs/name"},
        "effect_class": {"const": "read_only"}, "idempotency": {"const": "safe"}, "tenant_scoped": {"const": true}
      }
    },
    "planStep": {
      "type": "object", "additionalProperties": false,
      "required": ["step_id", "kind", "capability", "target_ref", "input_schema_ref", "output_schema_ref", "read_only"],
      "properties": {
        "step_id": {"$ref": "#/$defs/name"},
        "kind": {"enum": ["OBSERVE_METRICS", "INSPECT_LOGS", "CORRELATE_CHANGE"]},
        "capability": {"$ref": "#/$defs/capabilityRef"},
        "target_ref": {"$ref": "#/$defs/name"},
        "input_schema_ref": {"$ref": "#/$defs/name"},
        "output_schema_ref": {"$ref": "#/$defs/name"},
        "read_only": {"const": true}
      }
    },
    "planCandidate": {
      "type": "object", "additionalProperties": false,
      "required": ["plan_id", "schema_version", "steps", "plan_hash"],
      "properties": {
        "plan_id": {"type": "string", "pattern": "^plan_[a-f0-9]{32}$"},
        "schema_version": {"const": "decision.v1"},
        "steps": {"type": "array", "maxItems": 3, "items": {"$ref": "#/$defs/planStep"}},
        "plan_hash": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}