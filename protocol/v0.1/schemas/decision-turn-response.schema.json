{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:avaargsh:agent-decision:protocol:v0.1:response",
  "title": "Agent Decision Turn Response v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "invocation_id",
    "result"
  ],
  "properties": {
    "protocol_version": {
      "const": "0.1"
    },
    "invocation_id": {
      "$ref": "#/$defs/id"
    },
    "result": {
      "oneOf": [
        {
          "$ref": "#/$defs/finalResponse"
        },
        {
          "$ref": "#/$defs/actionProposals"
        },
        {
          "$ref": "#/$defs/needsInput"
        }
      ]
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "uri": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*://[^\\s]+$"
    },
    "finalResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "text",
        "evidence_refs"
      ],
      "properties": {
        "kind": {
          "const": "final_response"
        },
        "text": {
          "type": "string",
          "maxLength": 65536
        },
        "structured_output": {
          "type": "object",
          "maxProperties": 256
        },
        "evidence_refs": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/uri"
          }
        }
      }
    },
    "actionProposals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "proposals"
      ],
      "properties": {
        "kind": {
          "const": "action_proposals"
        },
        "proposals": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/actionProposal"
          }
        }
      }
    },
    "actionProposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposal_id",
        "capability_id",
        "capability_version",
        "arguments",
        "target_resource_ref",
        "rationale_ref"
      ],
      "properties": {
        "proposal_id": {
          "$ref": "#/$defs/id"
        },
        "capability_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
        },
        "capability_version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"
        },
        "arguments": {
          "type": "object",
          "maxProperties": 128
        },
        "target_resource_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "id"
          ],
          "properties": {
            "type": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "id": {
              "$ref": "#/$defs/id"
            }
          }
        },
        "rationale_ref": {
          "$ref": "#/$defs/uri"
        }
      }
    },
    "needsInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "prompt",
        "missing_fields"
      ],
      "properties": {
        "kind": {
          "const": "needs_input"
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "missing_fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      }
    }
  }
}
