{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:avaargsh:agent-decision:protocol:v0.1:request",
  "title": "Agent Decision Turn Request v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "invocation_id",
    "agent_id",
    "bundle_digest",
    "release_id",
    "session_id",
    "run_id",
    "turn_id",
    "user_input_ref",
    "context_projection_ref",
    "allowed_capabilities",
    "deadline",
    "trace_context"
  ],
  "properties": {
    "protocol_version": {
      "const": "0.1"
    },
    "invocation_id": {
      "$ref": "#/$defs/id"
    },
    "agent_id": {
      "$ref": "#/$defs/id"
    },
    "bundle_digest": {
      "$ref": "#/$defs/digest"
    },
    "release_id": {
      "$ref": "#/$defs/id"
    },
    "session_id": {
      "$ref": "#/$defs/id"
    },
    "run_id": {
      "$ref": "#/$defs/id"
    },
    "turn_id": {
      "$ref": "#/$defs/id"
    },
    "user_input_ref": {
      "$ref": "#/$defs/contextRef"
    },
    "context_projection_ref": {
      "$ref": "#/$defs/contextRef"
    },
    "allowed_capabilities": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/capability"
      }
    },
    "deadline": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
    },
    "trace_context": {
      "$ref": "#/$defs/traceContext"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "contextRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "sha256",
        "media_type",
        "schema_version"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*://[^\\s]+$"
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        },
        "media_type": {
          "type": "string",
          "minLength": 3,
          "maxLength": 127,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9!#$&^_.+-]*/[A-Za-z0-9][A-Za-z0-9!#$&^_.+-]*$"
        },
        "schema_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_id",
        "capability_version",
        "arguments_schema_digest"
      ],
      "properties": {
        "capability_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
        },
        "capability_version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"
        },
        "arguments_schema_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "traceContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "traceparent"
      ],
      "properties": {
        "traceparent": {
          "type": "string",
          "pattern": "^00-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$"
        },
        "tracestate": {
          "type": "string",
          "maxLength": 512
        }
      }
    }
  }
}
